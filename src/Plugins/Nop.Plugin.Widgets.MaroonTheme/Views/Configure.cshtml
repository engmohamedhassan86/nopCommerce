@model ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
}

@await Component.InvokeAsync(typeof(StoreScopeConfigurationViewComponent))

<form asp-controller="MaroonTheme" asp-action="Configure" method="post">
    <section class="content">
        <div class="container-fluid">
            <div class="card card-default">
                <div class="card-body">
                    <p>
                        @Html.Raw(T("Plugins.Widgets.MaroonTheme.Description"))
                    </p>
                    <div class="form-group row">
                        <div class="col-md-3">
                            <nop-override-store-checkbox asp-for="@Model.Enabled_OverrideForStore" asp-input="@Model.Enabled" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                            <nop-label asp-for="Enabled" />
                        </div>
                        <div class="col-md-9">
                            <nop-editor asp-for="Enabled" />
                            <span asp-validation-for="Enabled"></span>
                        </div>
                    </div>
                    <nop-nested-setting asp-for="Enabled">
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-override-store-checkbox asp-for="@Model.PrimaryColor_OverrideForStore" asp-input="@Model.PrimaryColor" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="PrimaryColor" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="PrimaryColor" html-attributes="@(new { placeholder = "#800000" })" />
                                <span asp-validation-for="PrimaryColor"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-override-store-checkbox asp-for="@Model.HoverColor_OverrideForStore" asp-input="@Model.HoverColor" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                <nop-label asp-for="HoverColor" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="HoverColor" html-attributes="@(new { placeholder = "#5c0000" })" />
                                <span asp-validation-for="HoverColor"></span>
                            </div>
                        </div>
                    </nop-nested-setting>
                    <div class="form-group row">
                        <div class="col-md-9 offset-md-3">
                            <input type="submit" name="save" class="btn btn-primary" value="@T("Admin.Common.Save")" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
